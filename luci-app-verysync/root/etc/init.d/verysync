#!/bin/sh /etc/rc.common

START=99
STOP=10
PIDFILE=/var/run/verysync.pid

start() {
  local enabled="$(/sbin/uci get verysync.config.enabled)"
  local port="$(/sbin/uci get verysync.config.port)"
  stop
  [ "${enabled}" = "1" ] || return 0
  export HOME="/root/"
  /usr/bin/verysync -gui-address="0.0.0.0:${port}" -logfile="/var/log/verysync.log" -home="/etc/verysync/" -no-browser >/dev/null 2>&1 &
  echo $! > "$PIDFILE"
}

stop() {
  [ -f "$PIDFILE" ] || return 0
  kill -9 $(cat "$PIDFILE") >/dev/null 2>&1
  rm -f "$PIDFILE"
}
